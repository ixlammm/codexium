{
  "name": "codex-rebuild",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "check": "node tooling/build.cjs",
    "rebuild": "node tooling/build.cjs --rebuild",
    "package": "node tooling/build.cjs --package",
    "build:codex": "cargo build --bin codex -p codex-cli --manifest-path ../codexium-cli/codex-rs/Cargo.toml",
    "prepare:resources": "node tooling/prepare-resources.cjs"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/packager": "^18.4.4",
    "@lobehub/icons-static-svg": "^1.94.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  }
}
